# Created automatically by npm run setup for a local installation.
# For a hosted installation use a private PostgreSQL server and HTTPS.
DATABASE_URL=postgresql://prisme:CHANGE_ME@127.0.0.1:55432/prisme
APP_ORIGIN=http://127.0.0.1:3000
# Set a cryptographically random value of at least 32 bytes.
SESSION_SECRET=CHANGE_ME
# Optional: path outside the public directory; defaults to .local/auth.json.
AUTH_FILE=.local/auth.json
